const express=require('express');

const BookModel =require('../BooKDB/BookDB')
const {
    BodyValidator,
    chooseBookValidator,
    bookId
} =require('../BookValidate/BookValidation')

const BookRouters = express.Router()

//Post
BookRouters.post('/Books',chooseBookValidator,BodyValidator,createBooks);
async function createBooks(req,res) {
    try{
        const data = req.body
        if(Array.isArray(data)){
            const createBooks = await BookModel.insertMany(data)
            return res.json({message:req.t('bookCreated'),BooK:createBooks})
        }
        else{
            const createBooks = await BookModel.create(data)
            return res.json({message:req.t('bookCreated'),BooK:createBooks})
        }
    }
    catch(error){
        return res.status(400).json({message:'Book not crreate',error})
    }
}
